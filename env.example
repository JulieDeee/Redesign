# Paste your real values in Vercel → Project → Settings → Environment Variables
OPENAI_API_KEY=
# Quality: low (~1¢), medium (~5¢), high (~20¢, default — best looking)
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
ANTHROPIC_API_KEY=
AMAZON_AFFILIATE_TAG=yourtag-20
# Optional. Anthropic model used for the design brief.
ANTHROPIC_MODEL=claude-sonnet-5
# BLOB_READ_WRITE_TOKEN is added automatically when you create a Blob store in Vercel → Storage.
# Only needed if your Anthropic key is not scoped to a workspace.
# Find it in console.anthropic.com under Settings -> Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Extra shops for "Shop this room". Both run through Impact Radius — paste the
# tracking link they give you, with {url} where the destination goes.
# Leave empty to hide that shop.
HOME_DEPOT_LINK=
WAYFAIR_LINK=
